rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /partidas/{partidaId} {
      // Solo usuarios autenticados anónimamente pueden consultar una partida por su código.
      // La lista completa de partidas no se puede consultar.
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.code == partidaId
        && request.resource.data.game is string
        && request.resource.data.level is string
        && request.resource.data.when is string;

      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      match /respuestas/{uid} {
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 50
          && request.resource.data.status in ['join', 'maybe', 'no'];

        allow get: if request.auth != null
          && (request.auth.uid == uid
            || get(/databases/$(database)/documents/partidas/$(partidaId)).data.ownerUid == request.auth.uid);

        allow list: if request.auth != null
          && get(/databases/$(database)/documents/partidas/$(partidaId)).data.ownerUid == request.auth.uid;

        allow delete: if request.auth != null
          && (request.auth.uid == uid
            || get(/databases/$(database)/documents/partidas/$(partidaId)).data.ownerUid == request.auth.uid);
      }
    }
  }
}
