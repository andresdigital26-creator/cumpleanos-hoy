rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /usuarios/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /codigosJugador/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && code.matches('[A-Z0-9]{6}');
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /invitaciones/{invitationId} {
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.gameCode is string
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/codigosJugador/$(request.resource.data.recipientCode)).data.uid == request.resource.data.recipientUid;
      allow get, list: if signedIn()
        && (resource.data.recipientUid == request.auth.uid || resource.data.senderUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
        && request.resource.data.status in ['accepted','rejected','later','busy'];
      allow delete: if signedIn() && resource.data.senderUid == request.auth.uid;
    }

    match /partidas/{partidaId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.code == partidaId
        && request.resource.data.game is string
        && request.resource.data.level is string
        && request.resource.data.when is string;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      match /respuestas/{uid} {
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 50
          && request.resource.data.status in ['join', 'maybe', 'no'];
        allow get: if signedIn() && (request.auth.uid == uid || get(/databases/$(database)/documents/partidas/$(partidaId)).data.ownerUid == request.auth.uid);
        allow list: if signedIn() && get(/databases/$(database)/documents/partidas/$(partidaId)).data.ownerUid == request.auth.uid;
        allow delete: if signedIn() && (request.auth.uid == uid || get(/databases/$(database)/documents/partidas/$(partidaId)).data.ownerUid == request.auth.uid);
      }
    }
  }
}
