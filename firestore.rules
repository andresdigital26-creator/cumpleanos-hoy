
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // PERFILES DE LOS USUARIOS
    // Cada usuario administra solamente su propio perfil.
    match /usuarios/{uid} {
      allow get, list: if signedIn();

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.birthday is string
        && request.resource.data.birthday.matches('^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && request.resource.data.photoData is string
        && request.resource.data.photoData.size() < 850000;

      allow delete: if signedIn()
        && request.auth.uid == uid;
    }

    // CHAT PUBLICO DE CUMPLEAÑOS HOY
    match /chat_publico/{messageId} {

      // Los usuarios autenticados pueden leer los mensajes.
      allow read: if signedIn();

      // Solo pueden enviar mensajes usando su propia cuenta
      // y los datos de su perfil registrado.
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'photoData', 'text', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'photoData', 'text', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.photoData is string
        && request.resource.data.photoData.size() < 850000
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.name ==
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.name
        && request.resource.data.photoData ==
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.photoData
        && request.resource.data.createdAt == request.time;

      // Los mensajes enviados no se pueden modificar ni borrar.
      allow update, delete: if false;
    }
  }
}
